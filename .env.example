# ---------------------------------------------------------------------------
# Elevazio — environment template
#
# Copy to `.env.local` and fill in real values. `.env*` is git-ignored
# (except this file), so nothing here is ever committed by accident.
#
# There are no secrets in this project. Everything below is public
# configuration that is inlined into the client bundle, which is exactly why it
# must be limited to non-sensitive values. Never prefix a token, key or
# password with NEXT_PUBLIC_ — anything so prefixed is readable by visitors.
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site. Used for `metadataBase`, canonical
# URLs, `sitemap.xml`, `robots.txt` and the JSON-LD `@id` values, so it must be
# the public https origin with no trailing path.
NEXT_PUBLIC_SITE_URL=https://elevazio.com
